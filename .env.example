# Template for the docker-compose .env file.
# Copy to .env and fill in the values:   cp .env.example .env

# ─── Database ────────────────────────────────────────────────────────────────
# Shared by the Postgres container and the Django backend (values must match).
DB_NAME=db.postgres
DB_USER=user
DB_PASSWORD=your-db-password
DB_HOST=db
DB_PORT=5432

# ─── LLM extractor (OpenAI) ──────────────────────────────────────────────────
# Optional. If OPENAI_API_KEY is blank, scheduling runs from the availability
# calendar only (neutral willingness) — the pipeline still works end-to-end.
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-5-mini-2025-08-07

# ─── Optimizer ───────────────────────────────────────────────────────────────
# Pyomo solver name; must be installed in the backend image (default: cbc).
OPTIMIZER_SOLVER=cbc
